DATABASE_URL=postgresql://postgres:postgres@localhost:5434/code_journal
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
APP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# External network for reverse proxy (docker-compose.proxy.yml)
PROXY_NETWORK=proxy
